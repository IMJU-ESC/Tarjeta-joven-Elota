rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdministrador() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    function esMaster() {
      return esAdministrador()
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.rol == "Master";
    }

    match /administradores/{adminId} {
      allow get: if estaAutenticado()
        && (request.auth.uid == adminId || esAdministrador());
      allow list: if esAdministrador();
      allow create, update, delete: if esMaster();
    }

    // Compatibilidad temporal con el acceso actual por correo y contraseña.
    match /jovenes/{jovenId} {
      allow read, create, update: if true;
      allow delete: if esAdministrador();
    }

    match /negocios/{negocioId} {
      allow read, create, update: if true;
      allow delete: if esAdministrador();
    }

    match /visitas/{visitaId} {
      allow read, create, delete: if true;
      allow update: if esAdministrador();
    }

    match /anuncios/{anuncioId} {
      allow read: if true;
      allow create, update, delete: if esAdministrador();
    }

    match /promociones/{promocionId} {
      allow read, create, update, delete: if true;
    }

    match /empleos/{empleoId} {
      allow read, create, update, delete: if true;
    }

    match /sistema/{documentoId} {
      allow read, write: if true;
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
