rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function administrador() {
      return autenticado() && exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }
    function master() {
      return administrador() && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.rol == "Master";
    }
    function negocioActivo() {
      return autenticado()
        && exists(/databases/$(database)/documents/negocios/$(request.auth.uid))
        && get(/databases/$(database)/documents/negocios/$(request.auth.uid)).data.estatus == "Activo";
    }

    match /administradores/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || administrador());
      allow list: if administrador();
      allow create, update, delete: if master();
    }

    match /jovenes/{uid} {
      allow get: if administrador() || (autenticado() && request.auth.uid == uid);
      allow list: if administrador();
      allow create, delete: if administrador();
      allow update: if administrador() || (
        autenticado() && request.auth.uid == uid
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.correo == resource.data.correo
        && request.resource.data.codigoUnicoQR == resource.data.codigoUnicoQR
        && request.resource.data.estatus == "Activo"
      );
    }

    match /negocios/{uid} {
      allow read: if administrador() || resource.data.estatus == "Activo"
        || (autenticado() && request.auth.uid == uid);
      allow create, delete: if administrador();
      allow update: if administrador() || (
        autenticado() && request.auth.uid == uid
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.correo == resource.data.correo
        && request.resource.data.estatus == "Activo"
      );
    }

    match /tarjetas/{uid} {
      allow read: if administrador() || negocioActivo() || (autenticado() && request.auth.uid == uid);
      allow write: if administrador();
    }

    match /visitas/{visitaId} {
      allow read: if administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid)
        || (autenticado() && resource.data.youthUid == request.auth.uid);
      allow create: if negocioActivo() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if administrador() || (negocioActivo() && resource.data.ownerUid == request.auth.uid);
      allow update: if administrador();
    }

    match /anuncios/{anuncioId} {
      allow read: if true;
      allow write: if administrador();
    }

    match /promociones/{publicacionId} {
      allow read: if resource.data.estatus == "Activa" || administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid);
      allow create: if negocioActivo() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid);
    }

    match /empleos/{publicacionId} {
      allow read: if resource.data.estatus == "Activa" || administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid);
      allow create: if negocioActivo() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid);
    }

    match /sistema/{documentoId} {
      allow read: if true;
      allow write: if administrador() || negocioActivo();
    }

    match /{documento=**} { allow read, write: if false; }
  }
}
