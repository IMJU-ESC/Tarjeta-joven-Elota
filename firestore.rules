rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() { return request.auth != null; }
    function administrador() {
      return autenticado() && exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }
    function master() {
      return administrador() && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.rol == "Master";
    }
    function negocioActivo() {
      return autenticado()
        && exists(/databases/$(database)/documents/negocios/$(request.auth.uid))
        && get(/databases/$(database)/documents/negocios/$(request.auth.uid)).data.estatus == "Activo";
    }

    match /administradores/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || administrador());
      allow list: if administrador();
      allow create, update, delete: if master();
    }

    match /jovenes/{uid} {
      allow get: if administrador() || (autenticado() && request.auth.uid == uid);
      allow list: if administrador();
      allow create, update, delete: if administrador();
    }

    match /negocios/{uid} {
      // El directorio público se entrega desde /api/directorio con campos
      // permitidos. Los documentos completos contienen datos internos.
      allow get: if administrador() || (autenticado() && request.auth.uid == uid);
      allow list: if administrador();
      allow create, delete: if administrador();
      allow update: if administrador() || (
        autenticado() && request.auth.uid == uid
        && resource.data.estatus == "Activo"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "nombreComercial", "giro", "horario", "telefono", "lat", "lng",
          "logo", "logoPath", "menuImagen"
        ])
      );
    }

    match /tarjetas/{uid} {
      // El QR se valida en una ruta segura del servidor. Un negocio nunca debe
      // poder listar todas las tarjetas ni leer datos de jóvenes directamente.
      allow get: if administrador() || (autenticado() && request.auth.uid == uid);
      allow list: if administrador();
      allow write: if administrador();
    }

    match /visitas/{visitaId} {
      allow read: if administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid)
        || (autenticado() && resource.data.youthUid == request.auth.uid);
      // Altas y anulaciones pasan por /api/negocio/tarjeta, donde se valida
      // el QR, la promoción y la identidad del negocio con Firebase Admin.
      allow create, delete: if administrador();
      allow update: if administrador();
    }

    match /anuncios/{anuncioId} {
      allow read: if true;
      allow write: if administrador();
    }

    match /promociones/{publicacionId} {
      allow read: if resource.data.estatus == "Activa" || administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid);
      allow create: if negocioActivo()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.estatus == "Activa";
      allow update: if administrador() || (
        negocioActivo()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.estatus == "Activa"
      );
      allow delete: if administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid);
    }

    match /empleos/{publicacionId} {
      allow read: if resource.data.estatus == "Activa" || administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid);
      allow create: if negocioActivo()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.estatus == "Activa";
      allow update: if administrador() || (
        negocioActivo()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.estatus == "Activa"
      );
      allow delete: if administrador()
        || (negocioActivo() && resource.data.ownerUid == request.auth.uid);
    }

    match /sistema/estado {
      allow read: if true;
      allow create: if administrador() || (
        negocioActivo()
        && request.resource.data.keys().hasOnly(["ultimaActualizacion"])
        && request.resource.data.ultimaActualizacion is number
      );
      allow update: if administrador() || (
        negocioActivo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ultimaActualizacion"])
        && request.resource.data.ultimaActualizacion is number
      );
    }

    match /sistema/{documentoId} { allow read, write: if false; }

    match /{documento=**} { allow read, write: if false; }
  }
}
