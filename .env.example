# Firebase Web App de Tarjeta Joven Elota
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cuenta de servicio (Firebase Console > Configuracion > Cuentas de servicio).
# Son variables privadas: nunca uses el prefijo NEXT_PUBLIC_ en estas tres.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=

# Correo institucional. Usa una contrasena de aplicacion de Google, no la contrasena normal.
EMAIL_USER=tarjetaimjuelota@gmail.com
EMAIL_APP_PASSWORD=

# URL final del proyecto en Vercel. Durante pruebas locales usa http://localhost:3000
APP_URL=http://localhost:3000

# Opcional: imagen publica para la firma de los correos.
EMAIL_SIGNATURE_URL=
