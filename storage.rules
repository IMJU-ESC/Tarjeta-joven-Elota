rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function administrador() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/administradores/$(request.auth.uid));
    }
    function negocioActivo() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/negocios/$(request.auth.uid));
    }
    function imagenLigera() {
      return request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /jovenes_perfiles/{archivo=**} {
      allow read: if true;
      allow write: if administrador();
    }
    match /jovenes_documentos/{archivo=**} {
      allow read, write: if administrador();
    }
    match /negocios_logos/{uid}/{archivo} {
      allow read: if true;
      allow create, update: if imagenLigera() && (administrador() || (negocioActivo() && request.auth.uid == uid));
      allow delete: if administrador() || (negocioActivo() && request.auth.uid == uid);
    }
    match /negocios_logos/{archivo} {
      allow read: if true;
      allow write: if administrador();
    }
    match /negocios_evidencias/{archivo=**} {
      allow read, write: if administrador();
    }
    match /promociones/{uid}/{archivo} {
      allow read: if true;
      allow create, update: if imagenLigera() && negocioActivo() && request.auth.uid == uid;
      allow delete: if administrador() || (negocioActivo() && request.auth.uid == uid);
    }
    match /menus/{uid}/{archivo} {
      allow read: if true;
      allow create, update: if imagenLigera() && negocioActivo() && request.auth.uid == uid;
      allow delete: if administrador() || (negocioActivo() && request.auth.uid == uid);
    }
    match /{archivo=**} { allow read, write: if false; }
  }
}
